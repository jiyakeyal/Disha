# ==============================================================================
# DISHA CAREER GUIDANCE - ENVIRONMENT CONFIGURATION
# ==============================================================================

# OPTION 1: OpenRouter (Recommended for Vercel / GitHub deployments)
# Get your API key from https://openrouter.ai/keys (starts with "sk-or-v1-...")
OPENROUTER_API_KEY="sk-or-v1-YOUR_OPENROUTER_KEY_HERE"

# Optional: Choose your Gemini model on OpenRouter (defaults to google/gemini-2.5-flash)
# Other choices: google/gemini-2.0-flash-001, google/gemini-flash-1.5-8b, google/gemini-2.5-pro
OPENROUTER_MODEL="google/gemini-2.5-flash"

# OPTION 2: Google AI Studio / Gemini Native
# If you are using native Google AI Studio, provide your key here (starts with "AIzaSy..."):
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# NOTE: The Disha LLM Adapter auto-detects your key!
# Even if you put an OpenRouter key into GEMINI_API_KEY, the adapter will detect
# the "sk-or-" prefix and automatically route through OpenRouter.

# APP_URL: The URL where this applet is hosted (used for OpenRouter HTTP-Referer header)
APP_URL="https://disha-career.vercel.app"
